# Production Environment Configuration
# Copy this file to production.tfvars and fill in the sensitive values
# NEVER commit production.tfvars to version control

environment = "production"
aws_region  = "us-east-1"

# VPC Configuration
vpc_cidr             = "10.1.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.1.1.0/24", "10.1.2.0/24", "10.1.3.0/24"]
private_subnet_cidrs = ["10.1.11.0/24", "10.1.12.0/24", "10.1.13.0/24"]

# Database Configuration (Production sizing)
db_name        = "recipedb"
db_volume_size = 30  # GB for PostgreSQL data volume (larger for production)

# EC2 ASG Configuration
instance_type     = "t4g.micro"  # Cost-optimized even for production (10-20 users)
backend_image_tag = "latest"

# Production database is ALWAYS protected from destruction
# The allow_dev_db_destruction variable has no effect on production

# Test users are DISABLED for production
# Real users will be created through the application UI

# ===================================================================
# SENSITIVE VALUES - Set via environment variables or fill in below
# ===================================================================
# These values should NEVER be committed to version control!
#
# Option 1: Use environment variables (recommended for CI/CD)
#   export TF_VAR_db_username="recipeuser"
#   export TF_VAR_db_password="GENERATE_STRONG_PASSWORD"
#   export TF_VAR_jwt_secret="GENERATE_JWT_SECRET"
#   export TF_VAR_jwt_refresh_secret="GENERATE_JWT_REFRESH_SECRET"
#
# Option 2: Uncomment and fill in the values below
#   (Make sure this file is in .gitignore!)
#
# db_username        = "recipeuser"
# db_password        = "REPLACE_WITH_STRONG_PASSWORD"
# jwt_secret         = "REPLACE_WITH_JWT_SECRET"
# jwt_refresh_secret = "REPLACE_WITH_JWT_REFRESH_SECRET"

# ===================================================================
# IMPORTANT: Production Security Requirements
# ===================================================================
# 1. Use VERY STRONG passwords (32+ characters, high entropy)
# 2. Store production secrets in a secure password manager
# 3. Rotate secrets quarterly or when team members leave
# 4. Never share production secrets via email/slack/chat
# 5. Use different secrets than development environment
# 6. Enable MFA on AWS account with production access
# 7. Limit who has access to production secrets
#
# ===================================================================
# How to generate secure production secrets:
# ===================================================================
# openssl rand -base64 48   # For db_password (extra strong)
# openssl rand -base64 48   # For jwt_secret (extra strong)
# openssl rand -base64 48   # For jwt_refresh_secret (extra strong)
#
# Save these in a secure password manager immediately!
